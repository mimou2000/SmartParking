rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════════
//  قواعد أمان Firebase Storage - نظام SmartParking
// ══════════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {
    
    // ════════════════════════════════════════════════════════════════════════
    //  دوال مساعدة
    // ════════════════════════════════════════════════════════════════════════
    
    // التحقق من أن المستخدم مسجل دخوله
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // التحقق من نوع الملف (صور فقط)
    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // التحقق من حجم الملف (أقصى 5 ميجابايت)
    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    
    // ════════════════════════════════════════════════════════════════════════
    //  صور المستخدمين
    // ════════════════════════════════════════════════════════════════════════
    match /users/{userId}/{allPaths=**} {
      // القراءة: أي مستخدم مسجل
      allow read: if isAuthenticated();
      
      // الكتابة: المستخدم نفسه فقط، مع التحقق من نوع وحجم الملف
      allow write: if isAuthenticated() && 
                      request.auth.uid == userId &&
                      isImageType() &&
                      isValidSize();
    }
    
    // ════════════════════════════════════════════════════════════════════════
    //  صور المناطق
    // ════════════════════════════════════════════════════════════════════════
    match /zones/{zoneId}/{allPaths=**} {
      // القراءة: أي مستخدم مسجل
      allow read: if isAuthenticated();
      
      // الكتابة: مسجل دخوله فقط (يجب التحقق من الدور في Firestore)
      allow write: if isAuthenticated() &&
                      isImageType() &&
                      isValidSize();
    }
    
    // ════════════════════════════════════════════════════════════════════════
    //  الملفات العامة (الشعارات، الأيقونات)
    // ════════════════════════════════════════════════════════════════════════
    match /public/{allPaths=**} {
      // القراءة: للجميع
      allow read: if true;
      
      // الكتابة: لا أحد (يتم رفعها عبر Console فقط)
      allow write: if false;
    }
    
    // ════════════════════════════════════════════════════════════════════════
    //  التقارير المصدّرة
    // ════════════════════════════════════════════════════════════════════════
    match /reports/{userId}/{allPaths=**} {
      // القراءة والكتابة: المستخدم نفسه فقط
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // ════════════════════════════════════════════════════════════════════════
    //  رفض أي مسار آخر
    // ════════════════════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
